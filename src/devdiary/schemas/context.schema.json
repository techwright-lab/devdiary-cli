{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devdiary:attribution:schema:v1:context",
  "title": "DevDiary Attribution Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "actor", "principal", "run", "started_at", "execution_chain", "command", "working_directory"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "display_name"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "kind": {"enum": ["agent", "automation"]},
        "display_name": {"type": "string", "minLength": 1},
        "humanized_name": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {"ref": {"type": "string", "minLength": 1}}
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "parent_ref": {"type": ["string", "null"]},
        "task_ref": {"type": ["string", "null"]}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "execution_chain": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/execution_entry"}
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "argument_count"],
      "properties": {
        "classification": {"const": "wrapped-process"},
        "argument_count": {"type": "integer", "minimum": 0}
      }
    },
    "working_directory": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "execution_entry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["orchestrator", "executor", "model"]},
        "system": {"type": "string", "minLength": 1},
        "session_ref": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "model"}}},
          "then": {"required": ["provider", "model"]},
          "else": {"required": ["system"]}
        }
      ]
    }
  }
}
